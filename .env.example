# OpenAI 兼容模型配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash
MODEL_BASE_URL_ALLOWLIST=https://dashscope.aliyuncs.com/compatible-mode/v1,https://api.openai.com/v1

# 可选：设置后，打开控制台需要输入访问密码
APP_ACCESS_PASSWORD=

# Immutable evidence retention is disabled by default. Set a positive value to enable cleanup.
EVIDENCE_RETENTION_DAYS=0
EVIDENCE_MAX_RUNS=0

# Runtime limits (all values are bounded in code)
CRAWL_CONCURRENCY=3
LLM_CONCURRENCY=4
MAX_MODEL_CALLS=25
MAX_TOTAL_TOKENS=200000
CRAWL_TIMEOUT_SECONDS=40
MODEL_TIMEOUT_SECONDS=55
RUN_TIMEOUT_SECONDS=900
NOTIFICATION_MAX_CHARS=3800

# Optional: R2 runtime backup for GitHub Actions. Keep these in GitHub Secrets, not .env.
R2_BUCKET=
R2_RUNTIME_PREFIX=aigc-competitor-agent/runtime

# 可选：企业微信群机器人 Webhook
WECOM_WEBHOOK=

# 可选：运行产物目录，默认写入项目下的 runtime/
# AGENT_RUNTIME_DIR=D:\path\to\agent-runtime
